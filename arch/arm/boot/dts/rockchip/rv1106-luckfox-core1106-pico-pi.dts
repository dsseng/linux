/dts-v1/;

#include "rv1106-luckfox-core1106.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "Luckfox Pico Pi";
	compatible = "rockchip,rv1103g-38x38-ipc-v10", "rockchip,rv1106g3";

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		reset-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1000000>;
		poll-interval = <100>;

		button-recovery {
			label = "Recovery";
			linux,code = <KEY_SETUP>;
			press-threshold-microvolt = <500000>;
		};
	};
};

/**********EMMC**********/
&emmc {
	vqmmc-supply = <&vcc_3v3>;
	vmmc-supply = <&vcc_3v3>;
	no-1-8-v;
	cap-mmc-highspeed;
	mmc-ddr-3_3v;
	bus-width = <8>;
	non-removable;
	rockchip,default-sample-phase = <90>;
	no-sdio;
	no-sd;
	disable-wp;
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_cmd &emmc_clk>;
};

/**********SDIO-WIFI**********/
&sdmmc {
	max-frequency = <50000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	rockchip,default-sample-phase = <90>;
	no-sd;
	no-mmc;
	no-1-8-v;
	disable-wp;
	supports-sdio;
	mmc-pwrseq = <&sdio_pwrseq>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_bus4 &sdmmc0_det>;
	status = "okay";

	vqmmc-supply = <&vcc_3v3>;
	vmmc-supply = <&vcc_3v3>;
	no-1-8-v;
};

&pinctrl {
	sdmmc0 {
		/omit-if-no-ref/
		sdmmc0_det: sdmmc0-det {
			rockchip,pins =
				/* sdmmc0_det */
				<3 RK_PA1 1 &pcfg_pull_down>;
		};
	};
};

&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "otg";
	usb-role-switch;
};
